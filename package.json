{
  "name": "rxjs-trace-viewer",
  "version": "0.3.0",
  "private": true,
  "description": "RxJS Trace Viewer: one SVG frame per state of a TLA+ trace, after Will Schultz's TLA+ Animation module",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tla": {
      "types": "./dist/tla.d.ts",
      "import": "./dist/tla.js"
    }
  },
  "bin": {
    "rxjs-trace-viewer": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "scripts"
  ],
  "sideEffects": false,
  "scripts": {
    "trace": "node src/cli.ts trace",
    "render": "node src/cli.ts render",
    "animate": "node src/cli.ts animate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "verify": "npm run format:check && npm run typecheck && npm test && npm run build && npm run animate && npm run render:runtime && npm run gallery",
    "record:runtime": "node scripts/record-runtime.mjs",
    "render:runtime": "node src/cli.ts render-runtime",
    "gallery": "node src/cli.ts gallery"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "tla-ts": "^0.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
